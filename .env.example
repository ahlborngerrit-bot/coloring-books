# .env.example: every environment variable the code reads (coloring_book_generator.py:51-52).
# Placeholders only. Copy to .env (gitignored) and fill in what you need.
# Nothing is required for the default backend (--backend pollinations, no key).

# [REQUIRED for --backend replicate] Replicate API token.
REPLICATE_API_TOKEN=your-replicate-api-token
# [REQUIRED for --backend huggingface] Hugging Face access token (sent as Bearer header).
HF_TOKEN=your-huggingface-token

# Test harness only (conftest.py): [OPTIONAL] "1" runs the 3 live Pollinations.ai tests.
RUN_NETWORK_TESTS=
